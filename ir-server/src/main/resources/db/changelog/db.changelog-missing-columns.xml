    <!-- 17. Drop subtype column from rate_packages table (master package concept removed) -->
    <changeSet id="missing-cols-17" author="system">
        <preConditions onFail="MARK_RAN" onError="CONTINUE">
            <columnExists tableName="rate_packages" columnName="subtype"/>
        </preConditions>

        <dropColumn tableName="rate_packages" columnName="subtype"/>

        <comment>Drop subtype column from rate_packages - master package concept removed</comment>
    </changeSet>

    <changeSet id="missing-cols-18" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="accounts"/>
            <columnExists tableName="accounts" columnName="deleted_at"/>
        </preConditions>
        
        <comment>Clean epoch (1970-01-01) values - idempotent, safe for fresh/partial/full DB</comment>
        
        <!-- Accounts cleanup -->
        <update tableName="accounts">
            <column name="deleted_at" valueComputed="NULL"/>
            <where>deleted_at = '1970-01-01 00:00:00' AND is_deleted = false</where>
        </update>
        <update tableName="accounts">
            <column name="deleted_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>deleted_at = '1970-01-01 00:00:00' AND is_deleted = true</where>
        </update>
        
        <!-- Partners cleanup (same epoch bug) -->
        <update tableName="partners">
            <column name="deleted_at" valueComputed="NULL"/>
            <where>deleted_at = '1970-01-01 00:00:00' AND is_deleted = false</where>
        </update>
        <update tableName="partners">
            <column name="deleted_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>deleted_at = '1970-01-01 00:00:00' AND is_deleted = true</where>
        </update>
        
        <!-- Agreements cleanup (same epoch bug) -->
        <update tableName="agreements">
            <column name="deleted_at" valueComputed="NULL"/>
            <where>deleted_at = '1970-01-01 00:00:00' AND is_deleted = false</where>
        </update>
        <update tableName="agreements">
            <column name="deleted_at" valueComputed="CURRENT_TIMESTAMP"/>
            <where>deleted_at = '1970-01-01 00:00:00' AND is_deleted = true</where>
        </update>
    </changeSet>

    <changeSet id="missing-cols-19" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="accounts"/>
            <columnExists tableName="accounts" columnName="product_plan_id"/>
            <!-- Only run if OLD index exists (product_plan_id NOT in index columns) -->
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM information_schema.statistics 
                WHERE table_schema = DATABASE() 
                AND table_name = 'accounts' 
                AND index_name = 'uk_accounts_account_code'
                AND column_name = 'product_plan_id'
            </sqlCheck>
        </preConditions>
        
        <comment>Replace (account_code, deleted_at) with (account_code, product_plan_id, deleted_at)</comment>
        
        <dropIndex tableName="accounts" indexName="uk_accounts_account_code"/>
        
        <createIndex tableName="accounts" indexName="uk_accounts_account_code">
            <column name="account_code"/>
            <column name="product_plan_id"/>
            <column name="deleted_at"/>
        </createIndex>
        
        <rollback>
            <dropIndex tableName="accounts" indexName="uk_accounts_account_code"/>
            <createIndex tableName="accounts" indexName="uk_accounts_account_code">
                <column name="account_code"/>
                <column name="deleted_at"/>
            </createIndex>
        </rollback>
    </changeSet>

