<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.10.xsd">

    <!--
        Migration: Add missing columns to entities based on revision db6e44ec9ac0da774cc620cc81321358c4292fbb
        
        This migration adds all columns that are expected by the Java entities but missing from the database schema.
    -->

    <!-- 1. Add missing columns to partners table -->
    <changeSet id="missing-cols-1" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="partners" columnName="billing_currency"/>
            </not>
        </preConditions>
        <comment>Add missing financial and technical columns to partners table</comment>
        
        <addColumn tableName="partners">
            <column name="billing_currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="billing_cycle" type="ENUM('MONTHLY', 'QUARTERLY', 'YEARLY')" defaultValue="MONTHLY">
                <constraints nullable="false"/>
            </column>
            <column name="payment_terms" type="VARCHAR(100)" defaultValue="NET_30">
                <constraints nullable="false"/>
            </column>
            <column name="tax_number" type="VARCHAR(50)" defaultValue="N/A">
                <constraints nullable="false"/>
            </column>
            <column name="bank_account_number" type="VARCHAR(50)" defaultValue="N/A">
                <constraints nullable="false"/>
            </column>
            <column name="swift_code" type="VARCHAR(11)">
                <constraints nullable="true"/>
            </column>
            <column name="point_code" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)">
                <constraints nullable="true"/>
            </column>
            <column name="routing_prefix" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 2. Add tadig_code column separately (already exists in roaming changelog but may not be applied) -->
    <changeSet id="missing-cols-2" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="partners" columnName="tadig_code"/>
            </not>
        </preConditions>
        <comment>Add tadig_code column to partners table if not exists</comment>
        
        <addColumn tableName="partners">
            <column name="tadig_code" type="VARCHAR(6)">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 3. Add interconnect_type column if not exists -->
    <changeSet id="missing-cols-3" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="partners" columnName="interconnect_type"/>
            </not>
        </preConditions>
        <comment>Add interconnect_type column to partners table if not exists</comment>
        
        <addColumn tableName="partners">
            <column name="interconnect_type" type="ENUM('IP','SS7','SIP','ROAMING')" defaultValue="IP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 4. Add clearing_house_id FK column if not exists -->
    <changeSet id="missing-cols-4" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="partners" columnName="clearing_house_id"/>
            </not>
        </preConditions>
        <comment>Add clearing_house_id FK column to partners table if not exists</comment>
        
        <addColumn tableName="partners">
            <column name="clearing_house_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 5. Add FK constraint for clearing_house_id if clearing_houses table exists -->
    <changeSet id="missing-cols-5" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="clearing_houses"/>
                <columnExists tableName="partners" columnName="clearing_house_id"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="fk_partner_clearing_house"/>
                </not>
            </and>
        </preConditions>
        <comment>Add FK constraint for partners.clearing_house_id</comment>
        
        <addForeignKeyConstraint baseTableName="partners" baseColumnNames="clearing_house_id"
                                 referencedTableName="clearing_houses" referencedColumnNames="id"
                                 constraintName="fk_partner_clearing_house"/>
    </changeSet>

    <!-- 6. Add missing columns to agreements table -->
    <changeSet id="missing-cols-6" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="agreements" columnName="next_billing_cycle_start_date"/>
            </not>
        </preConditions>
        <comment>Add missing columns to agreements table</comment>
        
        <addColumn tableName="agreements">
            <column name="next_billing_cycle_start_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="is_incoming_settlement" type="BIT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_outgoing_settlement" type="BIT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="is_net_settlement" type="BIT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="incoming_settlement_template_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="outgoing_settlement_template_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="net_settlement_template_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 7. Add missing PLMN columns to agreements table if not exists -->
    <changeSet id="missing-cols-7" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="agreements" columnName="home_plmn"/>
            </not>
        </preConditions>
        <comment>Add PLMN columns to agreements table if not exists</comment>
        
        <addColumn tableName="agreements">
            <column name="home_plmn" type="VARCHAR(6)">
                <constraints nullable="true"/>
            </column>
            <column name="visitor_plmn" type="VARCHAR(6)">
                <constraints nullable="true"/>
            </column>
            <column name="tap_direction" type="ENUM('TAP_IN','TAP_OUT')">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 8. Add FK constraints for template columns in agreements if template table exists -->
    <changeSet id="missing-cols-8" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="tblm_template_configuration"/>
                <columnExists tableName="agreements" columnName="incoming_settlement_template_id"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="fk_agreement_incoming_template"/>
                </not>
            </and>
        </preConditions>
        <comment>Add FK constraints for agreement template columns</comment>
        
        <addForeignKeyConstraint baseTableName="agreements" baseColumnNames="incoming_settlement_template_id"
                                 referencedTableName="tblm_template_configuration" referencedColumnNames="template_id"
                                 constraintName="fk_agreement_incoming_template"/>
        <addForeignKeyConstraint baseTableName="agreements" baseColumnNames="outgoing_settlement_template_id"
                                 referencedTableName="tblm_template_configuration" referencedColumnNames="template_id"
                                 constraintName="fk_agreement_outgoing_template"/>
        <addForeignKeyConstraint baseTableName="agreements" baseColumnNames="net_settlement_template_id"
                                 referencedTableName="tblm_template_configuration" referencedColumnNames="template_id"
                                 constraintName="fk_agreement_net_template"/>
    </changeSet>

    <!-- 9. Add missing columns to rate_packages table -->
    <changeSet id="missing-cols-9" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="rate_packages" columnName="currency"/>
            </not>
        </preConditions>
        <comment>Add currency column to rate_packages table if not exists</comment>
        
        <addColumn tableName="rate_packages">
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 10. Update agreements table to remove old settlement_type and add deleted_at -->
    <changeSet id="missing-cols-10" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="agreements" columnName="settlement_type"/>
                <not>
                    <columnExists tableName="agreements" columnName="deleted_at"/>
                </not>
            </and>
        </preConditions>
        <comment>Update agreements table structure</comment>
        
        <dropColumn tableName="agreements" columnName="settlement_type"/>
        <addColumn tableName="agreements">
            <column name="deleted_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 11. Update partners table unique constraint to include deleted_at -->
    <changeSet id="missing-cols-11" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                    <columnExists tableName="partners" columnName="deleted_at"/>
                </not>
            </and>
        </preConditions>
        <comment>Add deleted_at column to partners table</comment>
        
        <addColumn tableName="partners">
            <column name="deleted_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 12. Update unique constraints to include deleted_at for soft delete support -->
    <changeSet id="missing-cols-12" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="partners" columnName="deleted_at"/>
                <not>
                    <indexExists tableName="partners" indexName="uk_partners_partner_code"/>
                </not>
            </and>
        </preConditions>
        <comment>Update unique constraints for soft delete support</comment>
        
        <dropUniqueConstraint tableName="partners" constraintName="partner_code"/>
        <addUniqueConstraint tableName="partners" columnNames="partner_code,deleted_at" 
                             constraintName="uk_partners_partner_code"/>
    </changeSet>

    <changeSet id="missing-cols-13" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="agreements" columnName="deleted_at"/>
                <not>
                    <indexExists tableName="agreements" indexName="uk_agreements_agreement_code"/>
                </not>
            </and>
        </preConditions>
        <comment>Update agreements unique constraint for soft delete support</comment>
        
        <dropUniqueConstraint tableName="agreements" constraintName="agreement_code"/>
        <addUniqueConstraint tableName="agreements" columnNames="agreement_code,deleted_at" 
                             constraintName="uk_agreements_agreement_code"/>
    </changeSet>

    <!-- 14. Fix data types in tap_file_records table to match entity expectations -->
    <changeSet id="missing-cols-14" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="tap_file_records"/>
                <or>
                    <sqlCheck expectedResult="1">
                        SELECT COUNT(*) FROM information_schema.COLUMNS
                        WHERE TABLE_SCHEMA = DATABASE() 
                        AND TABLE_NAME = 'tap_file_records'
                        AND COLUMN_NAME = 'tap_decimal_places'
                        AND DATA_TYPE = 'int'
                    </sqlCheck>
                    <sqlCheck expectedResult="1">
                        SELECT COUNT(*) FROM information_schema.COLUMNS
                        WHERE TABLE_SCHEMA = DATABASE() 
                        AND TABLE_NAME = 'tap_file_records'
                        AND COLUMN_NAME = 'total_charge'
                        AND DATA_TYPE = 'bigint'
                    </sqlCheck>
                    <sqlCheck expectedResult="1">
                        SELECT COUNT(*) FROM information_schema.COLUMNS
                        WHERE TABLE_SCHEMA = DATABASE() 
                        AND TABLE_NAME = 'tap_file_records'
                        AND COLUMN_NAME = 'total_records'
                        AND DATA_TYPE = 'int'
                    </sqlCheck>
                </or>
            </and>
        </preConditions>
        <comment>Fix data types in tap_file_records to match BigInteger entity fields</comment>
        
        <modifyDataType tableName="tap_file_records" columnName="total_records" newDataType="DECIMAL(38,0)"/>
        <modifyDataType tableName="tap_file_records" columnName="total_charge" newDataType="DECIMAL(38,0)"/>
        <modifyDataType tableName="tap_file_records" columnName="tap_decimal_places" newDataType="DECIMAL(38,0)"/>
    </changeSet>

