    <!-- Rename account_code to account_code_or_hplmn in accounts table -->
    <!-- Supports both INTERCONNECT (user account code) and ROAMING (Home PLMN code) use cases -->
    <changeSet id="missing-cols-22" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="accounts"/>
            <columnExists tableName="accounts" columnName="account_code"/>
            <not>
                <columnExists tableName="accounts" columnName="account_code_or_hplmn"/>
            </not>
        </preConditions>
        <comment>Rename account_code to account_code_or_hplmn - dual-purpose field for INTERCONNECT account codes and ROAMING HPLMN codes</comment>
        <renameColumn tableName="accounts"
                      oldColumnName="account_code"
                      newColumnName="account_code_or_hplmn"
                      columnDataType="VARCHAR(255)"/>
    </changeSet>

    <!-- Rebuild unique index on accounts after column rename -->
    <changeSet id="missing-cols-23" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="accounts"/>
            <columnExists tableName="accounts" columnName="account_code_or_hplmn"/>
            <indexExists tableName="accounts" indexName="uk_accounts_account_code"/>
            <!-- Only rebuild if index still references old column name -->
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM information_schema.statistics
                WHERE table_schema = DATABASE()
                AND table_name = 'accounts'
                AND index_name = 'uk_accounts_account_code'
                AND column_name = 'account_code'
            </sqlCheck>
        </preConditions>
        <comment>Rebuild unique index uk_accounts_account_code to reference renamed column account_code_or_hplmn</comment>
        <dropIndex tableName="accounts" indexName="uk_accounts_account_code"/>
        <createIndex tableName="accounts" indexName="uk_accounts_account_code" unique="true">
            <column name="account_code_or_hplmn"/>
            <column name="product_plan_id"/>
            <column name="deleted_at"/>
        </createIndex>
    </changeSet>

    <!-- Make interconnect_type nullable: required only for INTERCONNECT line of business -->
    <changeSet id="partner-interconnect-nullable" author="system">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="partners"/>
                <columnExists tableName="partners" columnName="interconnect_type"/>
                <sqlCheck expectedResult="NO">
                    SELECT IS_NULLABLE FROM information_schema.COLUMNS
                    WHERE TABLE_SCHEMA = DATABASE()
                    AND TABLE_NAME = 'partners'
                    AND COLUMN_NAME = 'interconnect_type'
                </sqlCheck>
