<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.10.xsd">

    <changeSet id="tax-config-table" author="Ajay kumar">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tax_configs"/>
            </not>
        </preConditions>
        <createTable tableName="tax_configs">
            <column name="tax_config_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country_code" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
            <column name="region_code" type="VARCHAR(10)"/>
            <column name="tax_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_name" type="VARCHAR(50)"/>
            <column name="standard_rate" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_split_applicable" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="split_component_1_name" type="VARCHAR(20)"/>
            <column name="split_component_2_name" type="VARCHAR(20)"/>
            <column name="split_component_3_name" type="VARCHAR(20)"/>
            <column name="place_of_supply_rule" type="VARCHAR(30)"/>
            <column name="allows_input_credit" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="effective_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="effective_to" type="DATE"/>
            <column name="created_date" type="DATETIME"/>
            <column name="modified_date" type="DATETIME"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="deleted_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="tax_configs"
                             columnNames="country_code, region_code, tax_type, effective_from, deleted_at"
                             constraintName="uk_tax_config"/>
    </changeSet>

    <changeSet id="invoice-column-tax-type" author="Ajay kumar">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="invoices"/>
                <not><columnExists tableName="invoices" columnName="tax_type"/></not>
            </and>
        </preConditions>
        <addColumn tableName="invoices">
            <column name="tax_type" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

