    <changeSet id="agreement-fk-tax-config" author="Ajay kumar">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="agreements"/>
                <tableExists tableName="tax_configs"/>
                <not><foreignKeyConstraintExists foreignKeyName="fk_agreement_tax_config"/></not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseTableName="agreements"
                                 baseColumnNames="tax_config_id"
                                 constraintName="fk_agreement_tax_config"
                                 referencedTableName="tax_configs"
                                 referencedColumnNames="tax_config_id"
                                 onDelete="SET NULL"/>
    </changeSet>

