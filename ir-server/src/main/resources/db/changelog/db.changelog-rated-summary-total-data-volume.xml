<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.10.xsd">

    <changeSet id="add-total-data-volume-to-rated-summary" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="rated_summary" columnName="total_data_volume"/>
            </not>
        </preConditions>
        <addColumn tableName="rated_summary">
            <column name="total_data_volume" type="DECIMAL(19,4)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
