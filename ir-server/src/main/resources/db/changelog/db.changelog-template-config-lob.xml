<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.10.xsd">

    <changeSet id="add_line_of_business_to_template_configuration" author="system">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <columnExists tableName="tblm_template_configuration" columnName="line_of_business"/>
            </not>
        </preConditions>
        <addColumn tableName="tblm_template_configuration">
            <column name="line_of_business" type="ENUM('INTERCONNECT', 'ROAMING')"/>
        </addColumn>
    </changeSet>

    <changeSet id="modify_line_of_business_to_enum" author="system">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <columnExists tableName="tblm_template_configuration" columnName="line_of_business"/>
        </preConditions>
        <modifyDataType tableName="tblm_template_configuration" columnName="line_of_business" newDataType="ENUM('INTERCONNECT', 'ROAMING')"/>
    </changeSet>

</databaseChangeLog>
